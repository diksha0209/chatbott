{
  "entities": {
    "ChatThread": {
      "title": "ChatThread",
      "description": "Persistent conversation thread storing long-term memory summary, PDF count, and turn count.",
      "type": "object",
      "properties": {
        "chatId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "workspaceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "memorySummary": {
          "type": "string",
          "maxLength": 12000,
          "description": "Running distilled memory anchor capturing key facts from Turn 1 to current turn."
        },
        "lastMessagePreview": {
          "type": "string",
          "maxLength": 300
        },
        "messageCount": {
          "type": "integer"
        },
        "pdfCount": {
          "type": "integer"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "chatId",
        "workspaceId",
        "title",
        "memorySummary",
        "lastMessagePreview",
        "messageCount",
        "pdfCount",
        "createdAt",
        "updatedAt"
      ]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Single ordered turn in a conversation from start to finish, including PDF attachments and generated PDF specs.",
      "type": "object",
      "properties": {
        "messageId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "chatId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "workspaceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "role": {
          "type": "string",
          "enum": ["user", "assistant"]
        },
        "content": {
          "type": "string",
          "maxLength": 100000
        },
        "turnIndex": {
          "type": "integer"
        },
        "attachments": {
          "type": "array",
          "description": "PDF files attached to this message (max 5)."
        },
        "generatedPdf": {
          "type": "object",
          "description": "Optional structured PDF specification generated during this turn."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["messageId", "chatId", "workspaceId", "role", "content", "turnIndex", "createdAt"]
    },
    "ChatDocument": {
      "title": "ChatDocument",
      "description": "Uploaded PDF parsed into persistent text memory so the chatbot retains full document knowledge across sessions.",
      "type": "object",
      "properties": {
        "docId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "chatId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "workspaceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "fileName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "pageCount": {
          "type": "integer"
        },
        "fileSize": {
          "type": "integer"
        },
        "extractedText": {
          "type": "string",
          "maxLength": 450000
        },
        "summary": {
          "type": "string",
          "maxLength": 8000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "docId",
        "chatId",
        "workspaceId",
        "fileName",
        "pageCount",
        "fileSize",
        "extractedText",
        "summary",
        "createdAt"
      ]
    }
  },
  "firestore": {
    "/workspaces/{workspaceId}/chats/{chatId}": {
      "schema": { "$ref": "#/entities/ChatThread" },
      "description": "Persistent chat threads scoped by client workspace ID without authentication."
    },
    "/workspaces/{workspaceId}/chats/{chatId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/ChatMessage" },
      "description": "Ordered chat messages from Turn 1 to latest turn."
    },
    "/workspaces/{workspaceId}/chats/{chatId}/documents/{docId}": {
      "schema": { "$ref": "#/entities/ChatDocument" },
      "description": "Parsed PDF documents bound to a chat thread's persistent memory."
    }
  }
}
