rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Primitive Helpers ---
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function chatParentPath(workspaceId, chatId) {
      return /databases/$(database)/documents/workspaces/$(workspaceId)/chats/$(chatId);
    }

    // --- Validation Blueprints ---
    function isValidChatThread(data, workspaceId, chatId) {
      return data.keys().hasAll([
          'chatId', 'workspaceId', 'title', 'memorySummary', 'lastMessagePreview',
          'messageCount', 'pdfCount', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'chatId', 'workspaceId', 'title', 'memorySummary', 'lastMessagePreview',
          'messageCount', 'pdfCount', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.chatId)
        && data.chatId == chatId
        && isValidId(data.workspaceId)
        && data.workspaceId == workspaceId
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 160
        && data.memorySummary is string && data.memorySummary.size() <= 12000
        && data.lastMessagePreview is string && data.lastMessagePreview.size() <= 300
        && data.messageCount is int && data.messageCount >= 0 && data.messageCount <= 50000
        && data.pdfCount is int && data.pdfCount >= 0 && data.pdfCount <= 200
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAttachmentList(listData) {
      return listData is list
        && listData.size() <= 5
        && (listData.size() == 0 || (
          listData[0] is map
          && listData[0].keys().hasAll(['docId', 'fileName', 'pageCount', 'fileSize'])
          && listData[0].keys().hasOnly(['docId', 'fileName', 'pageCount', 'fileSize'])
          && isValidId(listData[0].docId)
          && listData[0].fileName is string && listData[0].fileName.size() >= 1 && listData[0].fileName.size() <= 255
          && listData[0].pageCount is int && listData[0].pageCount >= 0 && listData[0].pageCount <= 5000
          && listData[0].fileSize is int && listData[0].fileSize >= 0 && listData[0].fileSize <= 52428800
        ));
    }

    function isValidGeneratedPdf(pdfData) {
      return pdfData is map
        && pdfData.keys().hasAll(['title', 'fileName', 'createdAtIso', 'sections'])
        && pdfData.keys().hasOnly(['title', 'subtitle', 'author', 'fileName', 'createdAtIso', 'summary', 'sections'])
        && pdfData.title is string && pdfData.title.size() >= 1 && pdfData.title.size() <= 200
        && (!('subtitle' in pdfData) || (pdfData.subtitle is string && pdfData.subtitle.size() <= 300))
        && (!('author' in pdfData) || (pdfData.author is string && pdfData.author.size() <= 120))
        && pdfData.fileName is string && pdfData.fileName.size() >= 1 && pdfData.fileName.size() <= 200
        && pdfData.createdAtIso is string && pdfData.createdAtIso.size() <= 64
        && (!('summary' in pdfData) || (pdfData.summary is string && pdfData.summary.size() <= 4000))
        && pdfData.sections is list && pdfData.sections.size() <= 40
        && (pdfData.sections.size() == 0 || pdfData.sections[0] is map);
    }

    function isValidChatMessage(data, workspaceId, chatId, messageId) {
      return data.keys().hasAll(['messageId', 'chatId', 'workspaceId', 'role', 'content', 'turnIndex', 'createdAt'])
        && data.keys().hasOnly([
          'messageId', 'chatId', 'workspaceId', 'role', 'content', 'turnIndex',
          'attachments', 'generatedPdf', 'createdAt'
        ])
        && isValidId(data.messageId)
        && data.messageId == messageId
        && isValidId(data.chatId)
        && data.chatId == chatId
        && isValidId(data.workspaceId)
        && data.workspaceId == workspaceId
        && data.role in ['user', 'assistant']
        && data.content is string && data.content.size() <= 100000
        && data.turnIndex is int && data.turnIndex >= 1 && data.turnIndex <= 50000
        && (!('attachments' in data) || isValidAttachmentList(data.attachments))
        && (!('generatedPdf' in data) || isValidGeneratedPdf(data.generatedPdf))
        && data.createdAt is timestamp;
    }

    function isValidChatDocument(data, workspaceId, chatId, docId) {
      return data.keys().hasAll([
          'docId', 'chatId', 'workspaceId', 'fileName', 'pageCount',
          'fileSize', 'extractedText', 'summary', 'createdAt'
        ])
        && data.keys().hasOnly([
          'docId', 'chatId', 'workspaceId', 'fileName', 'pageCount',
          'fileSize', 'extractedText', 'summary', 'createdAt'
        ])
        && isValidId(data.docId)
        && data.docId == docId
        && isValidId(data.chatId)
        && data.chatId == chatId
        && isValidId(data.workspaceId)
        && data.workspaceId == workspaceId
        && data.fileName is string && data.fileName.size() >= 1 && data.fileName.size() <= 255
        && data.pageCount is int && data.pageCount >= 0 && data.pageCount <= 5000
        && data.fileSize is int && data.fileSize >= 0 && data.fileSize <= 52428800
        && data.extractedText is string && data.extractedText.size() <= 450000
        && data.summary is string && data.summary.size() <= 8000
        && data.createdAt is timestamp;
    }

    // --- Collection Rules (No Authentication Required) ---
    match /workspaces/{workspaceId}/chats/{chatId} {
      allow get: if isValidId(workspaceId) && isValidId(chatId) && existing().workspaceId == workspaceId;
      allow list: if isValidId(workspaceId) && resource.data.workspaceId == workspaceId;
      allow create: if isValidId(workspaceId) && isValidId(chatId)
        && isValidChatThread(incoming(), workspaceId, chatId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(workspaceId) && isValidId(chatId)
        && isValidChatThread(incoming(), workspaceId, chatId)
        && incoming().chatId == existing().chatId
        && incoming().workspaceId == existing().workspaceId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['title', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['memorySummary', 'lastMessagePreview', 'messageCount', 'pdfCount', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['title', 'memorySummary', 'lastMessagePreview', 'messageCount', 'pdfCount', 'updatedAt'])
        );
      allow delete: if isValidId(workspaceId) && isValidId(chatId) && existing().workspaceId == workspaceId;

      match /messages/{messageId} {
        allow get: if isValidId(workspaceId) && isValidId(chatId) && isValidId(messageId)
          && existing().workspaceId == workspaceId;
        allow list: if isValidId(workspaceId) && resource.data.workspaceId == workspaceId;
        allow create: if isValidId(workspaceId) && isValidId(chatId) && isValidId(messageId)
          && isValidChatMessage(incoming(), workspaceId, chatId, messageId)
          && incoming().createdAt == request.time
          && exists(chatParentPath(workspaceId, chatId))
          && get(chatParentPath(workspaceId, chatId)).data.workspaceId == workspaceId;
        allow update: if isValidId(workspaceId) && isValidId(chatId) && isValidId(messageId)
          && isValidChatMessage(incoming(), workspaceId, chatId, messageId)
          && incoming().messageId == existing().messageId
          && incoming().chatId == existing().chatId
          && incoming().workspaceId == existing().workspaceId
          && incoming().role == existing().role
          && incoming().content == existing().content
          && incoming().turnIndex == existing().turnIndex
          && incoming().createdAt == existing().createdAt
          && exists(chatParentPath(workspaceId, chatId))
          && get(chatParentPath(workspaceId, chatId)).data.workspaceId == workspaceId
          && incoming().diff(existing()).affectedKeys().hasOnly(['generatedPdf']);
        allow delete: if isValidId(workspaceId) && isValidId(chatId) && isValidId(messageId)
          && existing().workspaceId == workspaceId;
      }

      match /documents/{docId} {
        allow get: if isValidId(workspaceId) && isValidId(chatId) && isValidId(docId)
          && existing().workspaceId == workspaceId;
        allow list: if isValidId(workspaceId) && resource.data.workspaceId == workspaceId;
        allow create: if isValidId(workspaceId) && isValidId(chatId) && isValidId(docId)
          && isValidChatDocument(incoming(), workspaceId, chatId, docId)
          && incoming().createdAt == request.time
          && exists(chatParentPath(workspaceId, chatId))
          && get(chatParentPath(workspaceId, chatId)).data.workspaceId == workspaceId;
        allow update: if false;
        allow delete: if isValidId(workspaceId) && isValidId(chatId) && isValidId(docId)
          && existing().workspaceId == workspaceId;
      }
    }
  }
}
